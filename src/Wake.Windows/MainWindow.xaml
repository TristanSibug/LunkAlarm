<Window x:Class="Wake.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Wake — Alarm Clock" Width="1120" Height="840" MinWidth="760" MinHeight="600" WindowStartupLocation="CenterScreen" Icon="Assets/wake.ico" Closing="WindowClosing">
 <Grid>
  <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="MainContent">
   <StackPanel Margin="32,26">
    <DockPanel Margin="0,0,0,22">
     <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Image Source="Assets/wake.png" Width="32" Height="32" Margin="0,0,10,0"/><TextBlock Text="wake" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="Theme" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource MutedBrush}"/><ComboBox x:Name="ThemePicker" Width="150" Margin="0,0,12,0" SelectionChanged="ThemeChanged" AutomationProperties.Name="Theme"/><Button x:Name="FormatButton" Content="12h" Click="FormatClick" Margin="0"/></StackPanel>
    </DockPanel>
    <Border Style="{StaticResource Card}" Padding="28,18">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="MAKE ROOM FOR A GOOD MORNING" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="ClockText" FontSize="72" FontWeight="Light"/><TextBlock x:Name="SecondsText" FontSize="22" VerticalAlignment="Bottom" Margin="10,0,0,14" Foreground="{DynamicResource MutedBrush}"/></StackPanel><TextBlock x:Name="DateText"/><TextBlock x:Name="ZoneText" Style="{StaticResource Muted}"/></StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="230" Margin="20,0,0,0"><TextBlock Text="●  Windows system time" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Uses your Windows clock and time zone. Keep automatic time enabled in Windows Settings." Style="{StaticResource Muted}"/><Button Content="Date &amp; time settings ↗" Click="TimeSettingsClick"/></StackPanel>
     </Grid>
    </Border>
    <TextBlock x:Name="MessageText" Text="" Margin="0,0,0,12" Foreground="{DynamicResource AccentBrush}" AutomationProperties.LiveSetting="Polite"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
     <Border Grid.Column="0" Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="New alarm" Style="{StaticResource Heading}"/>
      <TextBlock Text="Label"/><TextBox x:Name="LabelInput" Text="Wake up" MaxLength="80" AutomationProperties.Name="Alarm label"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><RadioButton x:Name="AtTime" Content="At a time" IsChecked="True" GroupName="Mode" Foreground="{DynamicResource TextBrush}" Margin="0,0,24,0" Checked="ModeChanged"/><RadioButton x:Name="AfterDelay" Content="In how long" GroupName="Mode" Foreground="{DynamicResource TextBrush}" Checked="ModeChanged"/></StackPanel>
      <StackPanel x:Name="TimePanel"><TextBlock Text="Ring at (24-hour HH:mm)"/><TextBox x:Name="TimeInput" Text="07:00" FontSize="28" MaxLength="5" AutomationProperties.Name="Alarm time in 24 hour format"/></StackPanel>
      <StackPanel x:Name="TimerPanel" Visibility="Collapsed">
       <UniformGrid Columns="3"><StackPanel Margin="0,0,8,0"><TextBlock Text="Hours"/><TextBox x:Name="HoursInput" Text="0" MaxLength="2" AutomationProperties.Name="Timer hours"/></StackPanel><StackPanel Margin="0,0,8,0"><TextBlock Text="Minutes"/><TextBox x:Name="MinutesInput" Text="30" MaxLength="2" AutomationProperties.Name="Timer minutes"/></StackPanel><StackPanel><TextBlock Text="Seconds"/><TextBox x:Name="TimerSecondsInput" Text="0" MaxLength="2" AutomationProperties.Name="Timer seconds"/></StackPanel></UniformGrid>
       <WrapPanel Margin="0,0,0,10"><Button Content="5 min" Tag="5" Click="PresetClick"/><Button Content="25 min" Tag="25" Click="PresetClick"/><Button Content="1 hour" Tag="60" Click="PresetClick"/><Button Content="8 hours" Tag="480" Click="PresetClick"/></WrapPanel>
      </StackPanel>
      <TextBlock Text="Ringtone"/><ComboBox x:Name="TonePicker" DisplayMemberPath="Name" SelectedValuePath="Id" AutomationProperties.Name="Ringtone"/>
      <WrapPanel><Button x:Name="PreviewButton" Content="Preview / stop" Click="PreviewClick"/><Button Content="Use my own file…" Click="ImportClick"/><Button Content="Find sounds ↗" Click="FindSoundsClick"/></WrapPanel>
      <TextBlock x:Name="CustomText" Style="{StaticResource Muted}" Text="WAV, MP3 or WMA · up to 2 MB · copied to app storage"/>
      <TextBlock Text="Wake-up tests" FontWeight="SemiBold" Margin="0,12,0,2"/>
      <CheckBox x:Name="TypingToggle" Content="Type an 8-character code"/>
      <CheckBox x:Name="MathToggle" Content="Solve addition problems" Checked="MathChanged" Unchecked="MathChanged"/>
      <StackPanel x:Name="MathOptions" Visibility="Collapsed"><TextBlock Text="Number of problems"/><ComboBox x:Name="MathCountPicker" SelectedIndex="2" AutomationProperties.Name="Number of math problems"/></StackPanel>
      <TextBlock Text="Tests are saved per alarm. No snooze: the alarm rings until you complete them." Style="{StaticResource Muted}"/>
      <Button Content="＋  Add alarm" Style="{StaticResource Primary}" Click="AddClick" Padding="16,13"/>
     </StackPanel></Border>
     <StackPanel Grid.Column="2">
      <Border Style="{StaticResource Card}"><StackPanel>
       <DockPanel><TextBlock Text="Your alarms" Style="{StaticResource Heading}"/><TextBlock x:Name="CountText" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/></DockPanel>
       <TextBlock x:Name="NextText" Style="{StaticResource Muted}"/>
       <TextBlock x:Name="EmptyText" Text="A fresh start. Add your first alarm." Margin="0,14,0,20" Foreground="{DynamicResource MutedBrush}"/>
       <ItemsControl x:Name="AlarmList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource FieldBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Time}" FontSize="27" FontWeight="Light"/><TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,4,0,3"/><TextBlock Text="{Binding Details}" Style="{StaticResource Muted}"/></StackPanel><Button Grid.Column="1" Content="Remove" Tag="{Binding Id}" Click="RemoveClick" VerticalAlignment="Center" Padding="9,7" AutomationProperties.Name="Remove alarm"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Desktop options" Style="{StaticResource Heading}"/>
       <CheckBox x:Name="KeepAwakeToggle" Content="Keep awake while alarms are active" Checked="OptionsChanged" Unchecked="OptionsChanged"/>
       <CheckBox x:Name="WakeToggle" Content="Request wake from sleep" Checked="OptionsChanged" Unchecked="OptionsChanged"/>
       <CheckBox x:Name="LoginToggle" Content="Start Wake when I log in" Checked="LoginChanged" Unchecked="LoginChanged"/>
       <TextBlock x:Name="PowerText" Style="{StaticResource Muted}"/>
       <TextBlock Text="Closing this window keeps Wake in the tray. Quit from the tray menu to exit. Wake timers depend on your hardware and Windows power plan; Wake cannot ring while shut down." Style="{StaticResource Muted}"/>
      </StackPanel></Border>
     </StackPanel>
    </Grid>
    <TextBlock Text="Made for slower mornings. Ready when you are." HorizontalAlignment="Center" Style="{StaticResource Muted}"/>
   </StackPanel>
  </ScrollViewer>
  <Border x:Name="RingOverlay" Visibility="Collapsed" Background="{DynamicResource BackgroundBrush}" Padding="32" Panel.ZIndex="10">
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="440" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40">
    <TextBlock Text="☀" FontSize="60" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
    <TextBlock x:Name="RingLabel" FontSize="34" FontWeight="SemiBold" TextAlignment="Center" Margin="0,16,0,6"/>
    <TextBlock x:Name="RingTime" FontSize="20" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
    <TextBlock x:Name="StepText" Margin="0,20,0,12" TextAlignment="Center"/>
    <StackPanel x:Name="TypingPanel"><TextBlock x:Name="CodeText" FontFamily="Consolas" FontSize="42" TextAlignment="Center" Foreground="{DynamicResource AccentBrush}"/><TextBox x:Name="CodeInput" FontFamily="Consolas" FontSize="25" MaxLength="8" TextChanged="CodeChanged" AutomationProperties.Name="Type the challenge code, case sensitive"/></StackPanel>
    <StackPanel x:Name="MathPanel"><TextBlock x:Name="ProblemText" FontSize="38" TextAlignment="Center"/><TextBlock x:Name="AnswerText" FontSize="30" TextAlignment="Center" Margin="0,12" AutomationProperties.LiveSetting="Polite"/><UniformGrid Columns="3"><Button Content="1" Click="KeypadClick"/><Button Content="2" Click="KeypadClick"/><Button Content="3" Click="KeypadClick"/><Button Content="4" Click="KeypadClick"/><Button Content="5" Click="KeypadClick"/><Button Content="6" Click="KeypadClick"/><Button Content="7" Click="KeypadClick"/><Button Content="8" Click="KeypadClick"/><Button Content="9" Click="KeypadClick"/><Button Content="⌫" Click="KeypadClick" AutomationProperties.Name="Delete digit"/><Button Content="0" Click="KeypadClick"/><Button Content="OK" Click="KeypadClick" Style="{StaticResource Primary}"/></UniformGrid></StackPanel>
    <Button x:Name="StopButton" Content="Stop alarm" Style="{StaticResource Primary}" Click="StopClick" Padding="24,16"/>
    <TextBlock x:Name="ChallengeMessage" TextAlignment="Center" Margin="0,15" Foreground="{DynamicResource AccentBrush}" AutomationProperties.LiveSetting="Assertive"/>
    <TextBlock x:Name="RingWarning" TextAlignment="Center" Style="{StaticResource Muted}"/>
   </StackPanel></ScrollViewer>
  </Border>
 </Grid>
</Window>
